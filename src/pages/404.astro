---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { content, person, localePath } from "../data/site";

const lang = "it" as const;
const t = content[lang].notFound;
const title = `${t.heading} — ${person.name}`;
---

<Layout lang={lang} title={title}>
  <Header lang={lang} />
  <main id="main-content">
    <section class="section not-found">
      <div class="container container--narrow">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.heading}</h1>
        <p class="not-found__message">{t.message}</p>
        <a class="btn btn--primary" href={localePath(lang, "/")}>
          {t.cta}
        </a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .not-found {
    padding-block: var(--space-6);
    text-align: center;
  }

  .not-found h1 {
    font-size: clamp(2rem, 4vw + 1rem, 3rem);
    margin-bottom: var(--space-2);
  }

  .not-found__message {
    color: var(--color-ink-soft);
    max-width: 30rem;
    margin-inline: auto;
    margin-bottom: var(--space-3);
  }
</style>
