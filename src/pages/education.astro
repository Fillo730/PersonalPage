---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Experience from "../components/Experience.astro";
import Footer from "../components/Footer.astro";
import { content, defaultLocale, person } from "../data/site";

const title = `${content[defaultLocale].education.heading} — ${person.name}`;
---

<Layout title={title}>
  <Header />
  <main>
    <Experience section="education" id="education" />
  </main>
  <Footer />
</Layout>
