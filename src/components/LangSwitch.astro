---
// Selettore lingua IT/EN con bandierine. Lo stato viene salvato in
// localStorage; senza una preferenza salvata la lingua predefinita è
// l'italiano (vedi defaultLocale in src/data/site.ts).
---

<div class="lang-switch" role="group" aria-label="Cambia lingua / Change language">
  <button
    type="button"
    class="lang-btn"
    data-lang-btn="it"
    aria-label="Italiano"
    title="Italiano"
  >
    <span aria-hidden="true">🇮🇹</span>
  </button>
  <button
    type="button"
    class="lang-btn"
    data-lang-btn="en"
    aria-label="English"
    title="English"
  >
    <span aria-hidden="true">🇬🇧</span>
  </button>
</div>

<style>
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    font-size: 1.0625rem;
    line-height: 1;
    opacity: 0.4;
    filter: grayscale(60%);
    transition: opacity 0.15s ease, border-color 0.15s ease, filter 0.15s ease,
      transform 0.15s ease;
  }

  .lang-btn:hover {
    opacity: 1;
    filter: grayscale(0%);
    transform: translateY(-1px);
  }

  :root:not([data-lang="en"]) .lang-btn[data-lang-btn="it"],
  :root[data-lang="en"] .lang-btn[data-lang-btn="en"] {
    opacity: 1;
    filter: grayscale(0%);
    border-color: var(--color-border-strong);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-lang-btn]");
  const root = document.documentElement;

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const lang = button.dataset.langBtn;
      if (lang !== "it" && lang !== "en") return;
      root.dataset.lang = lang;
      root.lang = lang;
      localStorage.setItem("lang", lang);
    });
  });
</script>
