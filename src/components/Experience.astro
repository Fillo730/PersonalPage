---
import { content, locales } from "../data/site";

interface Props {
  section: "work" | "education";
  id: string;
}

const { section, id } = Astro.props;
---

<section id={id} class="section">
  <div class="container container--narrow">
    {
      locales.map((lang) => {
        const t = content[lang][section];
        return (
          <div data-lang-block={lang}>
            <div class="section-head">
              <p class="eyebrow">{t.eyebrow}</p>
              <h2>{t.heading}</h2>
            </div>

            <ol class="timeline">
              {t.items.map((item) => (
                <li class="timeline__item">
                  <div class="timeline__marker" aria-hidden="true" />
                  <div class="timeline__content">
                    <p class="timeline__period">{item.period}</p>
                    <div class="timeline__head">
                      {item.logo && (
                        <img
                          class="timeline__logo"
                          src={item.logo}
                          alt={item.organization}
                          loading="lazy"
                        />
                      )}
                      <div>
                        <h3 class="timeline__role">{item.role}</h3>
                        <p class="timeline__org">{item.organization}</p>
                      </div>
                    </div>
                    <p class="timeline__desc">{item.description}</p>
                    {item.tags && (
                      <ul class="timeline__tags">
                        {item.tags.map((tag) => (
                          <li class="tag">{tag}</li>
                        ))}
                      </ul>
                    )}
                    {item.subjectGroups && (
                      <div class="timeline__subjects">
                        {item.subjectGroups.map((group) => (
                          <details class="subject-group">
                            <summary>{group.label}</summary>
                            <ul>
                              {group.subjects.map((subject) => (
                                <li>{subject}</li>
                              ))}
                            </ul>
                          </details>
                        ))}
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-left: var(--space-4);
    margin: 0;
    list-style: none;
    border-left: 1px solid var(--color-border);
  }

  .timeline__item {
    position: relative;
  }

  .timeline__marker {
    position: absolute;
    left: calc(-1 * var(--space-4) - 5px);
    top: 0.4em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .timeline__period {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-bottom: 0.35rem;
  }

  .timeline__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .timeline__logo {
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    object-fit: contain;
    border-radius: calc(var(--radius) - 4px);
    border: 1px solid var(--color-border);
    background: #ffffff;
    padding: 0.4rem;
  }

  .timeline__role {
    font-size: 1.25rem;
    margin-bottom: 0.15rem;
  }

  .timeline__org {
    color: var(--color-accent);
    font-weight: 500;
  }

  .timeline__desc {
    color: var(--color-ink-soft);
    max-width: 38rem;
    margin-top: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .timeline__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .timeline__subjects {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 38rem;
    margin-top: 0.75rem;
  }

  .subject-group {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.6rem 0.85rem;
  }

  .subject-group summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-ink);
    list-style: none;
  }

  .subject-group summary::-webkit-details-marker {
    display: none;
  }

  .subject-group summary::before {
    content: "+";
    display: inline-block;
    width: 1rem;
    color: var(--color-accent);
    font-weight: 700;
  }

  .subject-group[open] summary::before {
    content: "−";
  }

  .subject-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .subject-group li {
    font-size: 0.8125rem;
    color: var(--color-ink-soft);
    background: var(--color-accent-soft);
    border-radius: 999px;
    padding: 0.25em 0.75em;
  }
</style>
