---
import { content, locales } from "../data/site";
---

<section id="cv" class="section cv">
  <div class="container container--narrow">
    {
      locales.map((lang) => {
        const t = content[lang].cv;
        return (
          <div data-lang-block={lang}>
            <div class="section-head">
              <p class="eyebrow">{t.eyebrow}</p>
              <h2>{t.heading}</h2>
            </div>

            <p class="cv__intro">{t.intro}</p>

            <div class="cv__actions">
              <a class="btn btn--primary" href={t.url} download>
                {t.downloadLabel}
              </a>
              <a class="cv__alt-lang" href={t.altLangUrl} download>
                {t.altLangLabel}
              </a>
            </div>

            <div class="cv__preview">
              <iframe src={t.url} title={t.heading} loading="lazy" />
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .cv__intro {
    color: var(--color-ink-soft);
    max-width: 32rem;
    margin-bottom: var(--space-3);
  }

  .cv__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cv__alt-lang {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .cv__alt-lang:hover {
    text-decoration: underline;
  }

  .cv__preview {
    margin-top: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-soft);
  }

  .cv__preview iframe {
    display: block;
    width: 100%;
    height: 70vh;
    border: 0;
  }
</style>
