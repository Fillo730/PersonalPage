---
import { content, person, localePath, type Locale } from "../data/site";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = content[lang].hero;
---

<section id="top" class="hero">
  <div class="container container--narrow hero__layout">
    <p class="eyebrow">{t.location}</p>
    <h1 class="hero__name">{person.name}</h1>
    <p class="hero__role">{t.role}</p>
    <p class="hero__tagline">{t.tagline}</p>
    <div class="hero__photo">
      <img src="/profile.jpg" alt={person.name} width="320" height="320" loading="lazy" />
    </div>
    <div class="hero__actions">
      <a class="btn btn--primary" href={localePath(lang, "/contact")}>
        {t.ctaContact}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
  }

  .hero__layout {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "eyebrow photo"
      "name photo"
      "role photo"
      "tagline photo"
      "actions photo";
    align-items: center;
    column-gap: var(--space-4);
  }

  .hero__layout .eyebrow {
    grid-area: eyebrow;
  }

  .hero__photo {
    grid-area: photo;
    justify-self: end;
  }

  .hero__photo img {
    width: 12rem;
    height: 12rem;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--color-border);
  }

  @media (max-width: 40rem) {
    .hero__layout {
      grid-template-columns: 1fr;
      grid-template-areas:
        "eyebrow"
        "name"
        "role"
        "tagline"
        "actions"
        "photo";
    }

    .hero__photo {
      justify-self: center;
      margin-block: var(--space-3) 0;
    }

    .hero__photo img {
      width: 9rem;
      height: 9rem;
    }
  }

  .hero__name {
    grid-area: name;
    font-size: clamp(2.5rem, 5vw + 1rem, 4rem);
    line-height: 1.05;
    margin-bottom: var(--space-1);
  }

  .hero__role {
    grid-area: role;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1vw + 1rem, 1.375rem);
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .hero__tagline {
    grid-area: tagline;
    max-width: 34rem;
    font-size: 1.125rem;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-4);
  }

  .hero__actions {
    grid-area: actions;
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
</style>
