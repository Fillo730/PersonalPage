---
import { content, locales, person } from "../data/site";
---

<section id="top" class="hero">
  <div class="container container--narrow">
    {
      locales.map((lang) => {
        const t = content[lang].hero;
        return (
          <div data-lang-block={lang}>
            <p class="eyebrow">{t.location}</p>
            <h1 class="hero__name">{person.name}</h1>
            <p class="hero__role">{t.role}</p>
            <p class="hero__tagline">{t.tagline}</p>
            <div class="hero__actions">
              <a class="btn btn--primary" href="/contact">
                {t.ctaContact}
              </a>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-5);
  }

  .hero__name {
    font-size: clamp(2.5rem, 5vw + 1rem, 4rem);
    line-height: 1.05;
    margin-bottom: var(--space-1);
  }

  .hero__role {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1vw + 1rem, 1.375rem);
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .hero__tagline {
    max-width: 34rem;
    font-size: 1.125rem;
    color: var(--color-ink-soft);
    margin-bottom: var(--space-4);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
</style>
