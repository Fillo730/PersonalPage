---
import { content, locales } from "../data/site";
---

<section id="projects" class="section">
  <div class="container">
    {
      locales.map((lang) => {
        const t = content[lang].projects;
        return (
          <div data-lang-block={lang}>
            <div class="section-head">
              <p class="eyebrow">{t.eyebrow}</p>
              <h2>{t.heading}</h2>
            </div>

            <div class="projects-grid">
              {t.items.map((project) => (
                <article class="card project-card">
                  {project.image && (
                    <img
                      class="project-card__image"
                      src={project.image}
                      alt={project.title}
                      loading="lazy"
                    />
                  )}
                  <div class="project-card__body">
                    <div class="project-card__head">
                      <h3>{project.title}</h3>
                      {project.inProgress && (
                        <span class="project-card__badge">{t.inProgressLabel}</span>
                      )}
                    </div>
                    <p class="project-card__desc">{project.description}</p>
                    <ul class="project-card__tags">
                      {project.tags.map((tag) => (
                        <li class="tag">{tag}</li>
                      ))}
                    </ul>
                    {project.link && (
                      <a class="project-card__link" href={project.link}>
                        {project.linkLabel ?? "→"} →
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-3);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 6px rgba(28, 26, 23, 0.06), 0 16px 32px rgba(28, 26, 23, 0.08);
  }

  .project-card__image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    display: block;
    border-bottom: 1px solid var(--color-border);
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.75rem;
    padding: var(--space-3);
  }

  .project-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .project-card h3 {
    font-size: 1.1875rem;
  }

  .project-card__badge {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    border-radius: 999px;
    padding: 0.25em 0.75em;
  }

  .project-card__desc {
    color: var(--color-ink-soft);
    flex-grow: 1;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-card__link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    margin-top: 0.25rem;
  }

  .project-card__link:hover {
    text-decoration: underline;
  }
</style>
