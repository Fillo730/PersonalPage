---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";
import {
  content,
  person,
  socials,
  localePath,
  stripLocalePrefix,
  type Locale,
} from "../data/site";

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
}

const {
  lang,
  title = content[lang].meta.title,
  description = content[lang].meta.description,
} = Astro.props;

const currentPath = stripLocalePrefix(Astro.url.pathname);
const itHref = localePath("it", currentPath);
const enHref = localePath("en", currentPath);

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  jobTitle: content[lang].hero.role,
  description: content[lang].hero.tagline,
  url: new URL(localePath(lang, "/"), Astro.site).href,
  email: `mailto:${person.email}`,
  sameAs: socials.map((social) => social.url),
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bologna",
    addressCountry: "IT",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Università di Bologna",
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Applica subito il tema salvato, prima del render, per evitare flash -->
    <script is:inline>
      (function () {
        var storedTheme = localStorage.getItem("theme");
        if (storedTheme === "light" || storedTheme === "dark") {
          document.documentElement.dataset.theme = storedTheme;
        }
      })();
    </script>

    <script>
      // Le View Transitions di Astro, a ogni cambio pagina, sostituiscono
      // tutti gli attributi di <html> con quelli della pagina appena
      // scaricata. Qui copiamo il tema corrente sul nuovo documento PRIMA
      // che lo scambio avvenga, così la scelta dell'utente non si perde.
      document.addEventListener("astro:before-swap", (event) => {
        const theme = document.documentElement.dataset.theme;
        if (theme) event.newDocument.documentElement.dataset.theme = theme;
      });
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="uG0VlpO9qyBu39z-NWeV7Cs--OdKjz5F0pPzZTnlZzI" />

    <!-- Versioni linguistiche alternative -->
    <link rel="alternate" hreflang="it" href={new URL(itHref, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(itHref, Astro.site)} />

    <!-- Open Graph / social sharing -->
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_US"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />

    <!-- Dati strutturati per i motori di ricerca (schema.org Person) -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} is:inline />

    <!-- Google Fonts: Fraunces (titoli) + Inter (testo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">{content[lang].skipToContent}</a>
    <slot />
    <Analytics />
  </body>
</html>
